:host {
  display: block;
  min-height: 100vh;
}

* {
  box-sizing: border-box;
}

/* =========================================================
   PAGE
   BLUE MARKETPLACE BACKGROUND
   ========================================================= */

.swap-page {
  min-height: 100vh;
  padding: 32px 24px 70px;

  background: linear-gradient(
    135deg,
    #2563eb 0%,
    #4f46e5 50%,
    #6366f1 100%
  );

  color: #111827;
}


/* =========================================================
   BACK BUTTON
   ========================================================= */

.back-button {
  display: flex;
  align-items: center;
  gap: 8px;

  width: fit-content;

  margin: 0 auto 24px;
  padding: 8px 0;

  border: 0;
  background: transparent;

  color: #ffffff;

  font-family: inherit;
  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.back-button:hover {
  color: #e0e7ff;
  transform: translateX(-2px);
}

.back-icon {
  color: #ffffff;
  font-size: 16px;
}


/* =========================================================
   STATE CARD
   ========================================================= */

.state-card {
  width: min(650px, 100%);

  margin: 70px auto;

  padding: 50px 35px;

  text-align: center;

  background: #ffffff;

  border: 1px solid #e5e7eb;
  border-radius: 20px;

  box-shadow:
    0 16px 45px rgba(17, 24, 39, 0.15);
}

.state-card h2 {
  margin: 18px 0 8px;

  color: #111827;

  font-size: 22px;
}

.state-card p {
  margin: 0 0 24px;

  color: #6b7280;

  font-size: 13px;
  line-height: 1.6;
}

.loading-orb {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 56px;
  height: 56px;

  margin: 0 auto;

  border: 1px solid rgba(79, 70, 229, 0.18);
  border-radius: 50%;

  background: rgba(79, 70, 229, 0.06);
}

.loading-orb span {
  width: 18px;
  height: 18px;

  border: 2px solid #e0e7ff;
  border-top-color: #4f46e5;

  border-radius: 50%;

  animation: spin 0.7s linear infinite;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 54px;
  height: 54px;

  margin: 0 auto;

  border-radius: 50%;

  background: #fef2f2;

  border: 1px solid #fecaca;

  color: #dc2626;

  font-size: 22px;
  font-weight: 800;
}


/* =========================================================
   MAIN CARD
   WHITE MARKETPLACE CARD
   ========================================================= */

.swap-card {
  width: min(980px, 100%);

  margin: 0 auto;

  overflow: hidden;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 22px;

  box-shadow:
    0 16px 45px rgba(17, 24, 39, 0.15);
}


/* =========================================================
   HEADER
   ========================================================= */

.swap-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;

  padding: 30px 38px;

  border-bottom: 1px solid #eef0f3;

  background: #ffffff;
}

.eyebrow {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-bottom: 8px;

  color: #4f46e5;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 1.5px;
}

.eyebrow-dot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #4f46e5;

  box-shadow:
    0 0 0 4px rgba(79, 70, 229, 0.09);
}

.swap-header h1 {
  margin: 0;

  color: #111827;

  font-size: 30px;
  font-weight: 750;

  line-height: 1.15;

  letter-spacing: -0.5px;
}

.swap-header p {
  margin: 8px 0 0;

  color: #6b7280;

  font-size: 13px;

  line-height: 1.6;
}

.swap-step {
  display: flex;
  align-items: center;

  gap: 6px;

  padding: 9px 12px;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  background: #f8f9fb;

  color: #6b7280;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.4px;
}

.swap-step strong {
  color: #4f46e5;

  font-size: 11px;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.requested-section,
.form-section {
  padding: 28px 38px;

  border-bottom: 1px solid #eef0f3;

  background: #ffffff;
}

.section-title {
  display: flex;
  align-items: flex-start;

  gap: 12px;

  margin-bottom: 17px;
}

.section-number {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 31px;
  height: 31px;

  flex-shrink: 0;

  border: 1px solid rgba(79, 70, 229, 0.16);

  border-radius: 9px;

  background: rgba(79, 70, 229, 0.07);

  color: #4f46e5;

  font-size: 9px;
  font-weight: 900;
}

.section-title h2 {
  margin: 1px 0 3px;

  color: #1f2937;

  font-size: 14px;
  font-weight: 750;
}

.section-title p {
  margin: 0;

  color: #6b7280;

  font-size: 10px;

  line-height: 1.5;
}

.section-title h2 span {
  margin-left: 6px;

  color: #9ca3af;

  font-size: 8px;
  font-weight: 600;

  text-transform: uppercase;
}


/* =========================================================
   REQUESTED ITEM
   ========================================================= */

.requested-item {
  display: grid;

  grid-template-columns: 190px 1fr;

  gap: 22px;

  padding: 14px;

  border: 1px solid #e5e7eb;

  border-radius: 16px;

  background: #f8f9fb;
}

.requested-image-wrapper {
  position: relative;

  height: 225px;

  overflow: hidden;

  border-radius: 12px;

  background: #f3f4f6;
}

.requested-image-wrapper img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.image-badge {
  position: absolute;

  left: 10px;
  bottom: 10px;

  padding: 6px 8px;

  border: 1px solid rgba(255, 255, 255, 0.5);

  border-radius: 6px;

  background: rgba(17, 24, 39, 0.78);

  color: #ffffff;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.8px;
}

.requested-info {
  display: flex;
  flex-direction: column;

  justify-content: center;

  min-width: 0;
}

.item-category {
  margin-bottom: 6px;

  color: #4f46e5;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1px;

  text-transform: uppercase;
}

.requested-info h2 {
  margin: 0;

  color: #111827;

  font-size: 25px;
  font-weight: 750;

  line-height: 1.15;
}

.item-brand {
  margin: 7px 0 13px;

  color: #6b7280;

  font-size: 11px;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  margin-bottom: 18px;
}

.item-tags span {
  padding: 6px 9px;

  border: 1px solid #e5e7eb;

  border-radius: 6px;

  background: #ffffff;

  color: #4b5563;

  font-size: 9px;
  font-weight: 700;
}

.requested-value {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  max-width: 390px;

  padding-top: 13px;

  border-top: 1px solid #e5e7eb;
}

.requested-value span {
  color: #6b7280;

  font-size: 9px;
}

.requested-value strong {
  color: #4f46e5;

  font-size: 18px;
  font-weight: 800;
}


/* =========================================================
   OFFER
   ========================================================= */

.offer-box {
  padding: 16px;

  border: 1px solid #e5e7eb;

  border-radius: 13px;

  background: #f8f9fb;
}

.offer-box label {
  display: block;

  margin-bottom: 8px;

  color: #1f2937;

  font-size: 11px;
  font-weight: 700;
}

.select-wrapper {
  position: relative;
}

.form-section select {
  width: 100%;

  height: 48px;

  padding: 0 42px 0 14px;

  appearance: none;

  border: 1px solid #d1d5db;

  border-radius: 10px;

  outline: none;

  background: #ffffff;

  color: #111827;

  font-family: inherit;
  font-size: 11px;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.form-section select:hover {
  border-color: #9ca3af;
}

.form-section select:focus {
  border-color: #4f46e5;

  box-shadow:
    0 0 0 3px rgba(79, 70, 229, 0.10);
}

.form-section select option {
  background: #ffffff;

  color: #111827;
}

.select-arrow {
  position: absolute;

  right: 14px;
  top: 50%;

  transform: translateY(-50%);

  color: #4f46e5;

  font-size: 13px;

  pointer-events: none;
}

.field-hint {
  display: block;

  margin-top: 7px;

  color: #9ca3af;

  font-size: 9px;
}


/* =========================================================
   EMPTY MESSAGE
   ========================================================= */

.empty-message {
  display: flex;
  align-items: center;

  gap: 12px;

  padding: 14px;

  border: 1px solid #fde68a;

  border-radius: 11px;

  background: #fffbeb;

  color: #92400e;

  font-size: 10px;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 32px;
  height: 32px;

  flex-shrink: 0;

  border-radius: 8px;

  background: #fef3c7;

  color: #b45309;

  font-size: 17px;
}

.empty-message strong {
  display: block;

  margin-bottom: 3px;

  color: #92400e;

  font-size: 11px;
}

.empty-message p {
  margin: 0;

  color: #a16207;

  font-size: 9px;

  line-height: 1.5;
}


/* =========================================================
   MESSAGE
   ========================================================= */

.message-box {
  padding: 14px;

  border: 1px solid #e5e7eb;

  border-radius: 13px;

  background: #f8f9fb;
}

.message-box textarea {
  display: block;

  width: 100%;

  min-height: 120px;

  padding: 12px;

  resize: vertical;

  border: 1px solid #d1d5db;

  border-radius: 9px;

  outline: none;

  background: #ffffff;

  color: #111827;

  font-family: inherit;
  font-size: 11px;

  line-height: 1.6;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.message-box textarea::placeholder {
  color: #9ca3af;
}

.message-box textarea:hover {
  border-color: #9ca3af;
}

.message-box textarea:focus {
  border-color: #4f46e5;

  box-shadow:
    0 0 0 3px rgba(79, 70, 229, 0.10);
}

.message-footer {
  display: flex;
  justify-content: space-between;

  gap: 20px;

  margin-top: 7px;
}

.message-footer span {
  color: #9ca3af;

  font-size: 9px;
}

.message-footer strong {
  color: #6b7280;

  font-size: 9px;
}


/* =========================================================
   ALERTS
   ========================================================= */

.alert {
  display: flex;
  align-items: center;

  gap: 10px;

  margin: 20px 38px 0;

  padding: 12px 14px;

  border-radius: 10px;

  font-size: 10px;
  font-weight: 650;
}

.alert-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 21px;
  height: 21px;

  flex-shrink: 0;

  border-radius: 50%;

  font-size: 9px;
  font-weight: 900;
}

.alert.error {
  border: 1px solid #fecaca;

  background: #fef2f2;

  color: #b42318;
}

.alert.error .alert-icon {
  background: #fee2e2;

  color: #dc2626;
}

.alert.success {
  border: 1px solid #bbf7d0;

  background: #ecfdf3;

  color: #147a3d;
}

.alert.success .alert-icon {
  background: #dcfce7;

  color: #16a34a;
}


/* =========================================================
   SUMMARY
   ========================================================= */

.swap-summary {
  display: grid;

  grid-template-columns:
    1fr
    55px
    1fr;

  align-items: center;

  gap: 12px;

  margin: 22px 38px 0;

  padding: 14px;

  border: 1px solid #e5e7eb;

  border-radius: 13px;

  background:
    linear-gradient(
      110deg,
      rgba(79, 70, 229, 0.045),
      rgba(59, 130, 246, 0.035)
    );
}

.summary-item {
  min-width: 0;

  padding: 10px 12px;

  border: 1px solid #e5e7eb;

  border-radius: 9px;

  background: #ffffff;
}

.summary-label {
  display: block;

  margin-bottom: 5px;

  color: #6b7280;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 1px;
}

.summary-item strong {
  display: block;

  overflow: hidden;

  color: #1f2937;

  font-size: 10px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-arrow {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  margin: auto;

  border-radius: 50%;

  background: rgba(79, 70, 229, 0.08);

  color: #4f46e5;

  font-size: 18px;
}


/* =========================================================
   FOOTER / ACTIONS
   ========================================================= */

.actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;

  gap: 12px;

  margin-top: 22px;

  padding: 22px 38px 28px;

  border-top: 1px solid #eef0f3;

  background: #fafafa;
}

.action-note {
  display: flex;
  align-items: center;

  gap: 8px;

  max-width: 330px;

  margin-right: auto;

  color: #6b7280;

  font-size: 9px;

  line-height: 1.45;
}

.secure-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 23px;
  height: 23px;

  flex-shrink: 0;

  border-radius: 7px;

  background: rgba(79, 70, 229, 0.08);

  color: #4f46e5;

  font-size: 9px;
}

.action-buttons {
  display: flex;

  gap: 9px;
}


/* =========================================================
   SECONDARY BUTTON
   ========================================================= */

.secondary-button {
  min-width: 90px;

  min-height: 46px;

  padding: 0 18px;

  border: 1px solid #d1d5db;

  border-radius: 10px;

  background: #ffffff;

  color: #374151;

  font-family: inherit;

  font-size: 10px;
  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease;
}

.secondary-button:hover:not(:disabled) {
  background: #f3f4f6;

  border-color: #9ca3af;

  color: #111827;
}


/* =========================================================
   PRIMARY BUTTON
   BLUE / PURPLE MARKETPLACE STYLE
   ========================================================= */

.primary-button {
  min-width: 185px;

  min-height: 46px;

  padding: 0 20px;

  border: 0;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #2563eb 0%,
      #4f46e5 100%
    );

  color: #ffffff;

  font-family: inherit;

  font-size: 10px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 7px 18px rgba(79, 70, 229, 0.20);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    opacity 0.2s ease;
}

.primary-button:hover:not(:disabled) {
  background:
    linear-gradient(
      135deg,
      #1d4ed8 0%,
      #4338ca 100%
    );

  transform: translateY(-1px);

  box-shadow:
    0 10px 24px rgba(79, 70, 229, 0.28);
}

.primary-button:disabled,
.secondary-button:disabled {
  opacity: 0.5;

  cursor: not-allowed;

  box-shadow: none;

  transform: none;
}

.button-arrow {
  margin-left: 7px;

  font-size: 15px;

  vertical-align: middle;
}

.spinner {
  display: inline-block;

  width: 13px;
  height: 13px;

  margin-left: 8px;

  border: 2px solid rgba(255, 255, 255, 0.3);

  border-top-color: #ffffff;

  border-radius: 50%;

  vertical-align: middle;

  animation: spin 0.7s linear infinite;
}


/* =========================================================
   ANIMATION
   ========================================================= */

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 760px) {

  .requested-section,
  .form-section {
    padding-left: 24px;
    padding-right: 24px;
  }

  .swap-header {
    padding: 28px 24px;
  }

  .alert {
    margin-left: 24px;
    margin-right: 24px;
  }

  .swap-summary {
    margin-left: 24px;
    margin-right: 24px;
  }

  .actions {
    padding-left: 24px;
    padding-right: 24px;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .swap-page {
    padding: 20px 12px 45px;
  }

  .swap-card {
    border-radius: 18px;
  }

  .swap-header {
    align-items: flex-start;

    flex-direction: column;

    padding: 25px 20px;
  }

  .swap-header h1 {
    font-size: 27px;
  }

  .swap-step {
    align-self: flex-start;
  }

  .requested-section,
  .form-section {
    padding: 24px 20px;
  }

  .requested-item {
    grid-template-columns: 1fr;

    gap: 15px;
  }

  .requested-image-wrapper {
    height: 290px;
  }

  .requested-info h2 {
    font-size: 23px;
  }

  .alert {
    margin-left: 20px;
    margin-right: 20px;
  }

  .swap-summary {
    grid-template-columns: 1fr;

    margin-left: 20px;
    margin-right: 20px;
  }

  .summary-arrow {
    transform: rotate(90deg);
  }

  .actions {
    align-items: stretch;

    flex-direction: column;

    padding: 20px;
  }

  .action-note {
    max-width: none;

    margin-right: 0;
  }

  .action-buttons {
    flex-direction: column-reverse;
  }

  .secondary-button,
  .primary-button {
    width: 100%;
  }
}


/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 400px) {

  .requested-image-wrapper {
    height: 250px;
  }

  .item-tags {
    gap: 5px;
  }

  .item-tags span {
    padding: 5px 7px;
  }
}